# Export these in the shell that runs coordinator.py / worth_it.py on YOUR machine:
#   set -a; . ./.env; set +a
RPC_URL=https://rpc.mainnet.chain.robinhood.com
COLLECTION_ADDRESS=0xCA75DF55Cc9C476DB27a7375D1fc8E794cf80721
MINER_ADDRESS=0x0000000000000000000000000000000000000000
WALLET_KEY_FILE=secrets/wallet.key
# GPU host reached over SSH; the repo must be cloned in REMOTE_DIR there
SSH_TARGET=root@gpu.example.invalid
SSH_PORT=22
SSH_OPTS=-i secrets/ssh.key
REMOTE_DIR=~/hashcatsminoor
REMOTE_PYTHON=python3
GPUS=0
# money and time limits
MAX_PRICE_ETH=0.01
TARGET_MINTS=3
MAX_SPEND_ETH=0.05
MAX_HOURS=2
STATE_DIR=state
