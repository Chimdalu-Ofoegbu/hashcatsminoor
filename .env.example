# Copy to .env, fill in, then load it in the shell that runs the tools on YOUR machine:
#   set -a; . ./.env; set +a
# Nothing in here goes to the GPU host except the public work.

# --- chain (defaults are fine) ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
COLLECTION_ADDRESS=0xCA75DF55Cc9C476DB27a7375D1fc8E794cf80721

# --- wallet: created by `python scripts/make_wallet.py` ---
WALLET_KEY_FILE=secrets/wallet.key
MINER_ADDRESS=0x0000000000000000000000000000000000000000

# --- where the GPU is: vast (rent it), ssh (a box you have), local (this machine) ---
PROVIDER=vast
VAST_GPU=RTX_4090
VAST_NUM_GPUS=1
VAST_MAX_DPH=0.60
VAST_DISK=20
# VAST_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu22.04
# VAST_QUERY_EXTRA=geolocation notin [CN,VN]
SSH_KEY_FILE=~/.ssh/id_ed25519
# for PROVIDER=ssh only:
# SSH_TARGET=root@1.2.3.4
# SSH_PORT=22
# USD_PER_HOUR=0.69
REMOTE_DIR=~/hashcatsminoor

# --- money and time limits (hard stops) ---
MAX_PRICE_ETH=0.01
TARGET_MINTS=3
MAX_SPEND_ETH=0.05
MAX_HOURS=2

# --- the gate: rent only when the live numbers clear these ---
SALE_ETH=0.0693
# OPENSEA_API_KEY=       # optional, free from opensea.io: the gate then uses the live top offer
FEE_PCT=5.5
MIN_PROFIT_PER_HOUR=5
MIN_REMAINING=300
# ETH_USD=2500          # set to skip the CoinGecko lookup

STATE_DIR=state
